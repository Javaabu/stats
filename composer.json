{
    "name": "javaabu/stats",
    "description": "Time series and categorical stats for Laravel: define a stat once, then chart it in Blade or Inertia React with Onu, compare periods, cache dashboards and export CSV",
    "homepage": "https://github.com/Javaabu/stats",
    "license": "MIT",
    "keywords": [
        "javaabu",
        "laravel",
        "stats",
        "charts",
        "dashboard",
        "inertia",
        "dhivehi"
    ],
    "authors": [
        {
            "name": "Arushad Ahmed",
            "email": "arushad@javaabu.com",
            "role": "Developer"
        },
        {
            "name": "Javaabu Pvt. Ltd.",
            "email": "info@javaabu.com",
            "homepage": "https://javaabu.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/filters",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/forms",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/manifest",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/permissions",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/stencil",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "javaabu/filters": "^1.0@dev",
        "javaabu/forms": "^2.0@dev",
        "javaabu/generator-helpers": "^1.3",
        "javaabu/manifest": "^1.0@dev",
        "javaabu/permissions": "^3.0@dev",
        "javaabu/stencil": "^1.0@dev",
        "nesbot/carbon": "^3.8.4"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0",
        "javaabu/boost-javaabu-guidelines": "^1.4",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.5.8",
        "spatie/laravel-activitylog": "^4.10"
    },
    "suggest": {
        "inertiajs/inertia-laravel": "Renders the stats pages with Inertia React when stats.views is inertia (^2.0)",
        "spatie/laravel-activitylog": "Needed by the built-in user logins stat (^4.10)"
    },
    "autoload": {
        "psr-4": {
            "Javaabu\\Stats\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Javaabu\\Stats\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-clover build/coverage.xml",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-next-gen": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "Javaabu\\Stats\\StatsServiceProvider"
            ],
            "aliases": {
                "Stats": "Javaabu\\Stats\\Facades\\Stats"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
